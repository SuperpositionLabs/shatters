# Copy to .env beside this file and fill in. Never commit the result.

# The domain this instance answers on. Must already resolve to this host, or
# certificate issuance fails.
SHATTERS_DOMAIN=chat.example.com

# Where the certificate authority sends expiry warnings.
TLS_EMAIL=you@example.com

# PostgreSQL password. Generate one rather than choosing it:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional. Defaults are 60/minute with a burst of 20 per IP, on the
# unauthenticated endpoints only.
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=20

# Optional. How many reverse proxies sit in front. The bundled stack has one
# (Caddy), which is the default. Only increase it if you add another proxy or
# CDN ahead of Caddy — claiming more hops than exist lets a caller forge the
# address the rate limiter sees.
# TRUSTED_PROXIES=1

# Optional. How often expired envelopes, challenges and tokens are deleted.
# "0" disables the sweeper if you would rather run it from cron.
# SWEEP_INTERVAL=1h
