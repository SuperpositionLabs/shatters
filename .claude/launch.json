{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shatters-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "web"
    },
    {
      "name": "shatters-web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "cwd": "web"
    }
  ]
}
